# ========================================================
# EXAM QUESTION PAPER PDF STORE - ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your real credentials.
# NEVER commit the real .env file to version control.
# ========================================================

# Application Settings
APP_NAME="Exam Paper PDF Store"
APP_ENV=development
PORT=8000
BASE_URL=http://localhost:8000

# --------------------------------------------------------
# A. Supabase Configuration (PostgreSQL Backend & Auth)
# --------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# The Service Role Key is backend-only; NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --------------------------------------------------------
# B. Razorpay Configuration (Test Mode Only Initially)
# --------------------------------------------------------
# Key ID is public/frontend usable for checkout modal
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Key Secret MUST remain strictly backend-only
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
# Webhook secret configured in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Currency setting (default: INR)
RAZORPAY_CURRENCY=INR

# --------------------------------------------------------
# C. Google Drive & Google Apps Script (PDF Storage & Delivery)
# --------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_FOLDER_ID=your_private_drive_folder_id
# Webhook URL for Google Apps Script payment-confirmed delivery
GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
APPS_SCRIPT_SECRET_TOKEN=your_internal_shared_secret

# --------------------------------------------------------
# D. Frontend Hosting & Deployment
# --------------------------------------------------------
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_AUTH_TOKEN=your_netlify_personal_access_token

